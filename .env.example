# ==============================================================================
# INFRANETRA ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and fill in real values. NEVER commit .env with secrets.
# ==============================================================================

# ==============================================================================
# RUNTIME ENVIRONMENT
# ==============================================================================

# Set to "production" for deployed backends (enforces strict AUTH_SECRET_KEY validation).
# Leave unset or "development" for local development.
NODE_ENV="development"
ENV="development"

# Server port (hosting platforms typically set PORT automatically)
PORT=8000

# ==============================================================================
# CRYPTOGRAPHIC SESSION AUTHENTICATION
# ==============================================================================

# Server-side session signing secret (REQUIRED in production).
# Must be a high-entropy string of at least 32 characters (recommended: 64-char hex).
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
# In development, a default fallback is used if not set.
AUTH_SECRET_KEY="YOUR_PRODUCTION_64_CHAR_HEX_SECRET_KEY"

# ==============================================================================
# BACKEND COORDINATION
# ==============================================================================

# Backend URL for Express/Vite server proxy (used in server.ts for production builds)
FASTAPI_URL=https://infranetra.onrender.com

# ==============================================================================
# CORS — ALLOWED ORIGINS
# ==============================================================================

# Comma-separated list of allowed frontend origins for the FastAPI backend.
# When not set, defaults to localhost development origins (http://localhost:3000, etc.).
# In production, set this to your deployed frontend URL(s).
# Example: CORS_ALLOWED_ORIGINS="https://infranetra.netlify.app"
# CORS_ALLOWED_ORIGINS=

# ==============================================================================
# DATABASE
# ==============================================================================

# Path to local SQLite database (relative to backend/ directory or absolute path).
# Used as local cache/fallback alongside Supabase PostgreSQL.
SQLITE_DB_PATH="infrastructure_projects.sqlite3"

# Directory for uploaded report files (relative to backend/ or absolute path).
UPLOAD_DIR="backend/uploads"

# ==============================================================================
# SUPABASE POSTGRESQL (Primary Database)
# ==============================================================================

# Supabase project URL
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"

# Supabase service-role key (Server-side ONLY — never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Supabase publishable/anon key (can be used client-side for public reads)
SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# ==============================================================================
# CLERK AUTHENTICATION
# ==============================================================================

# Client-side publishable key (safe to expose in frontend via VITE_ prefix)
VITE_CLERK_PUBLISHABLE_KEY="YOUR_CLERK_PUBLISHABLE_KEY"

# Server-side secret key (NEVER expose to frontend)
CLERK_SECRET_KEY="YOUR_CLERK_SECRET_KEY"

# ==============================================================================
# AI / LLM SERVICES (Optional — Chat Intelligence)
# ==============================================================================

# Groq API key (server-side only, used in server.ts for AI chat)
GROQ_API_KEY="YOUR_GROQ_API_KEY"

# Gemini API key (server-side only, alternative AI provider)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ==============================================================================
# ADMINISTRATOR CREDENTIALS (Server-side ONLY)
# ==============================================================================

# Fixed administrator username and password — used for Admin login only.
# These are server-side environment variables. Never expose to frontend.
ADMIN_USERNAME="YOUR_ADMIN_USERNAME"
ADMIN_PASSWORD="YOUR_ADMIN_PASSWORD"

# ==============================================================================
# FRONTEND PUBLIC VARIABLES (VITE_ prefix — exposed to browser)
# ==============================================================================

# Google Maps JavaScript API key (restricted to your domain in Google Cloud Console)
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# Backend API URL for frontend in production.
# In local development, the frontend uses http://127.0.0.1:8000 by default.
# In production, set this to your deployed backend HTTPS URL.
# Example: VITE_API_URL="https://infranetra-api.onrender.com"
VITE_API_URL="https://infranetra.onrender.com"
